(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes
  danger-enable-cmd     yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
    ;; Keychron Q1 HE: wireless ("Keychron Link ") and wired identities.
    ;; Use hashes because the wireless HID product name has trailing whitespace.
    "0x7A02521BF12E02AC"
    "0xBA0AA3EB0195AB2A"
  )
)

(defsrc
  esc   f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]     \
  caps  a     s     d     f     g     h     j     k     l     ;     '     ret
  lsft  z     x     c     v     b     n     m     ,     .     /     rsft
  fn    lctl  lalt  lmet              spc               rmet  ralt  ◀  ▲  ▼  ▶
)

(deflayer base
  _    🔅    🔆    mctl  sls   dtn   dnd   ◀◀    ▶⏸    ▶▶    🔇    🔉    🔊
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  @caps _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _
  lctl  @fn     _     _                _                @rmet _     _  _  _  _
)

(deflayer fn
  _     f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  _     _     _     _     _     _     _     _     _     _     _     _     _     @del
  _     _     _     _     lrld  _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _                 _                 _     _     ⇤  ⇞  ⇟  ⇥
)

(deflayer rmet
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     lrld  _     _     _     _     _     _     _     _     @del
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     @left @down @up   @rght _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _                 _                 _     _     _  _  _  _
)

(deflayer caps
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     @w    _     _     _     _     _     _     @o    _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _                 _                 _     _     _  _  _  _
)

(deflayer o
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _ _     _     _     _     _     _     _     _     _     _
  _     _     @wthr _     @strm _     _     @utm  @tick _     @spfy _     _     _
  _     _     _     @dscd @fndr @gtty @hlum _     @kvm  _     _     _     _
  _     _     _     @chat @zed  @obsd @ntes @msgs _     _     _     _
  _     _     _     _                 _                 _     _     _  _  _  _
)

(deflayer w
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     @wml  _     _     @wmr  _     _     _
  _     _     _     _     _     _     @wmn  @wmm  _     _     _     _
  _     _     _     _                 _                 _     _     _  _  _  _
)

(defvar
  tap-time 200
  hold-time 200
)

(defalias
  fn   (tap-hold-press $tap-time $hold-time fn   (layer-toggle fn))

  rmet (tap-hold-press $tap-time $hold-time rctl (multi rctl (layer-toggle rmet)))
  del  (unmod (rctl) del)
  left (unmod (rctl) left)
  down (unmod (rctl) down)
  up   (unmod (rctl) up)
  rght (unmod (rctl) rght)

  caps (tap-hold-press $tap-time $hold-time esc  (layer-toggle caps))

  o    (layer-while-held o)
  chat (cmd open -a ChatGPT)
  dscd (cmd open -a Discord)
  fndr (cmd open -a Finder)
  gtty (cmd open -a Ghostty)
  hlum (cmd open -a Helium)
  tick (cmd open -a TickTick)
  kvm  (cmd open -a GLKVM)
  obsd (cmd open -a Obsidian)
  msgs (cmd open -a Messages)
  ntes (cmd open -a Notes)
  strm (cmd open -a Stremio)
  spfy (cmd open -a Spotify)
  utm  (cmd open -a UTM)
  wthr (cmd open -a Weather)
  zed  (cmd open -a Zed)

  w    (layer-while-held w)
  wml  (cmd open -g raycast://extensions/raycast/window-management/left-half)
  wmr  (cmd open -g raycast://extensions/raycast/window-management/right-half)
  wmm  (cmd open -g raycast://extensions/raycast/window-management/maximize)
  wmn  (cmd open -g raycast://extensions/raycast/window-management/next-display)
)

(defchordsv2
  (lsft rsft) caps $tap-time first-release ()
)
